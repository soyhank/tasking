# Las dos únicas variables obligatorias (Supabase → Project Settings → API Keys)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxx

# Opcionales
# SUPABASE_SCHEMA=public        # esquema de Postgres donde se crean las tablas
# POSTGRES_URL_NON_POOLING=     # si está, el asistente crea las tablas solo
# APP_URL=                      # dirección pública; en Vercel se detecta sola
# TASKING_REPO=soyhank/tasking  # repositorio desde donde la PC servidor descarga el programa de WhatsApp

# Todo lo demás (contraseña, Gemini, correo) se configura en la app: /configurar y /ajustes
